{
  "extends": "./tsconfig.prod.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist/types/origin",
    "emitDeclarationOnly": true,
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist/**",
    "examples/**/*",
    "erdia-docs/**",
    "**/*.test.ts"
  ],
  "tsc-alias": {
    "replacers": {
      "base-url": {
        "enabled": false
      }
    }
  }
}